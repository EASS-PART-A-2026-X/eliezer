# .env.example: copy to .env (git-ignored) and edit. Never commit .env.

# Postgres password for the db service (Compose falls back to a dev default).
POSTGRES_PASSWORD=change-me

# Which model answers. "ollama:gemma4:e2b" = the real model in the ollama container:
# the first start downloads it (4.6 GB); it needs about 6 GB of free RAM and takes
# tens of seconds per photo on a CPU. "test" = demo mode: fixed stand-in answers,
# no download, no key, no cost.
AI_MODEL=ollama:gemma4:e2b

# Optional: CPU threads for the model. 4 is ~10x faster than one per CPU on a busy
# laptop; try more on a machine with many free cores. See "Speed" in the README.
# OLLAMA_NUM_THREAD=4

# Only if Ollama runs on the host instead of in the container:
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Optional: where the garden is (used in the AI instructions).
# GARDEN_REGION=Israel (Mediterranean climate)

# Optional: other host ports if 8000 or 8501 are taken.
# BACKEND_PORT=8000
# FRONTEND_PORT=8501
