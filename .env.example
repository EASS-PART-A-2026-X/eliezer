# .env.example: copy to .env (git-ignored) and edit. Never commit .env.

# Postgres password for the db service (Compose falls back to a dev default).
POSTGRES_PASSWORD=change-me

# "test" = demo mode: fixed stand-in answers, no network, no key, no cost.
AI_MODEL=test

# Real model (optional): Gemma 4 E2B on Ollama running on this machine.
# Needs Ollama >= 0.20.6 and `ollama pull gemma4:e2b`; see the README.
# AI_MODEL=ollama:gemma4:e2b
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Optional: where the garden is (used in the AI instructions).
# GARDEN_REGION=Israel (Mediterranean climate)

# Optional: other host ports if 8000 or 8501 are taken.
# BACKEND_PORT=8000
# FRONTEND_PORT=8501
